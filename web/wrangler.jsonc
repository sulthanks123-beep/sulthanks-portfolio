// Cloudflare deploy settings: serve the built site in dist/ as static assets.
// Used by `npx wrangler deploy` in Cloudflare's build (root directory: web).
{
  "name": "sulthanks-portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
